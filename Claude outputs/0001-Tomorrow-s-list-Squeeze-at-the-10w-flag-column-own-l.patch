     return d, updates
 
 
+def squeeze_mask(d, cfg):
+    """Price within sq_max_rwd ADR of the 10w line, tight, on the 10/20 MA (−0.3 to +1 ADR), not a full breakout yet."""
+    num = lambda c: pd.to_numeric(d[c], errors="coerce") if c in d.columns else pd.Series(np.nan, index=d.index)
+    adr = num("Adr").replace(0, np.nan)
+    m10, m20 = num("_10madist") / adr, num("_20madist") / adr
+    chg_adr = num("_chg_percentclose") / adr
+    lo, hi = cfg["sq_ma_min_adr"], cfg["sq_ma_max_adr"]
+    return ((num("_rel_wk_dist") <= cfg["sq_max_rwd"]) & (num("_rel_tightness_today") <= cfg["sq_max_reltight"])
+            & m10.between(lo, hi) & m20.between(lo, hi) & chg_adr.between(-0.5, cfg["sq_max_chg_adr"])).fillna(False)
+
+
