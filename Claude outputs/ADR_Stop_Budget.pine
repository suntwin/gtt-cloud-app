//@version=6
// ADR Stop Budget v2 — how far below your trigger a stop may sit (1/2 ADR ideal, 3/4 ADR max, hard cap %).
// The STOP goes under your box low; these lines only tell you whether that box low is tight enough.
// v2: after the close it uses the day that just finished (for tomorrow's plan); more trigger types.
indicator("ADR Stop Budget", shorttitle = "ADR SL", overlay = true, max_lines_count = 10, max_labels_count = 10, max_boxes_count = 2)

adrLen   = input.int(20, "ADR length (days)", minval = 5)
refMode  = input.string("Prior day high", "Trigger", options = ["Prior day high", "Opening range high", "Prior 1-hour bar high", "Manual"])
orMins   = input.int(5, "Opening range (minutes)", options = [1, 5, 15, 30, 60])
manualTr = input.price(0.0, "Manual trigger price (box high / reclaim level)")
kIdeal   = input.float(0.5, "Ideal stop (x ADR)", step = 0.05)
kMax     = input.float(0.75, "Max stop (x ADR)", step = 0.05)
capPct   = input.float(5.0, "Hard cap %", step = 0.5)
backBars = input.int(30, "Line length (bars back)", minval = 5)

// Daily values: ADR% like MarketInOut (SMA(high,20)/SMA(low,20) - 1) and day highs, completed vs current day
adrExpr = (ta.sma(high, adrLen) / ta.sma(low, adrLen) - 1) * 100
[adrPrev, hiPrev] = request.security(syminfo.tickerid, "D", [adrExpr[1], high[1]], lookahead = barmerge.lookahead_on)
[adrCur, hiCur, dayClose] = request.security(syminfo.tickerid, "D", [adrExpr, high, time_close], lookahead = barmerge.lookahead_off)
// Market closed and today's candle finished -> plan for the NEXT session from the day that just ended
dayDone = not na(dayClose) and timenow >= dayClose
adrPct  = dayDone ? adrCur : adrPrev
pdh     = dayDone ? hiCur : hiPrev

// Opening-range high (intraday charts only): high of the first N minutes of today's session
var float orHigh = na
var int   orEnd  = na
if timeframe.isintraday
    if session.isfirstbar_regular
        orHigh := high
        orEnd  := time + orMins * 60000
    else if not na(orEnd) and time < orEnd
        orHigh := math.max(orHigh, high)

hourHigh = request.security(syminfo.tickerid, "60", high[1], lookahead = barmerge.lookahead_on)

trig = switch refMode
    "Manual"                => manualTr > 0 ? manualTr : pdh
    "Opening range high"    => timeframe.isintraday and not dayDone and not na(orHigh) ? orHigh : pdh
    "Prior 1-hour bar high" => timeframe.isintraday and not dayDone ? hourHigh : pdh
    => pdh
trigName = refMode == "Manual" and manualTr > 0 ? "Manual" : refMode == "Opening range high" and timeframe.isintraday and not dayDone and not na(orHigh) ? str.tostring(orMins) + "m OR high" : refMode == "Prior 1-hour bar high" and timeframe.isintraday and not dayDone ? "Prior 1h high" : dayDone ? "Today's high (next session)" : "Prior day high"

rawIdeal = adrPct * kIdeal
rawMax   = adrPct * kMax
pIdeal   = math.min(rawIdeal, capPct)
pMax     = math.min(rawMax, capPct)
slIdeal  = trig * (1 - pIdeal / 100)
slMax    = trig * (1 - pMax / 100)
merged   = pIdeal == pMax

var line  lT = na
var line  lI = na
var line  lM = na
var label bT = na
var label bI = na
var label bM = na
var box   zn = na

if barstate.islast and not na(trig) and not na(adrPct)
    line.delete(lT)
    line.delete(lI)
    line.delete(lM)
    label.delete(bT)
    label.delete(bI)
    label.delete(bM)
    box.delete(zn)
    x1 = bar_index - backBars
    x2 = bar_index + 3
    zn := box.new(x1, trig, x2, slIdeal, border_color = color.new(color.green, 100), bgcolor = color.new(color.green, 88))
    lT := line.new(x1, trig, x2, trig, color = color.blue, width = 2)
    bT := label.new(x2, trig, trigName + " " + str.tostring(trig, format.mintick), style = label.style_label_left, color = color.blue, textcolor = color.white, size = size.small)
    if merged
        lI := line.new(x1, slIdeal, x2, slIdeal, color = color.orange, width = 2, style = line.style_dashed)
        bI := label.new(x2, slIdeal, "SL limit " + str.tostring(slIdeal, format.mintick) + " (-" + str.tostring(pIdeal, "#.##") + "%, capped; 1/2 ADR = " + str.tostring(rawIdeal, "#.#") + "%)  ADR " + str.tostring(adrPct, "#.#") + "%", style = label.style_label_left, color = color.orange, textcolor = color.white, size = size.small)
    else
        lI := line.new(x1, slIdeal, x2, slIdeal, color = color.green, width = 2, style = line.style_dashed)
        lM := line.new(x1, slMax, x2, slMax, color = color.orange, width = 2, style = line.style_dotted)
        bI := label.new(x2, slIdeal, "1/2 ADR SL " + str.tostring(slIdeal, format.mintick) + "  (-" + str.tostring(pIdeal, "#.##") + "%)", style = label.style_label_left, color = color.green, textcolor = color.white, size = size.small)
        bM := label.new(x2, slMax, "Max SL " + str.tostring(slMax, format.mintick) + "  (-" + str.tostring(pMax, "#.##") + "%" + (rawMax > capPct ? ", capped" : "") + ")  ADR " + str.tostring(adrPct, "#.#") + "%", style = label.style_label_left, color = color.orange, textcolor = color.white, size = size.small)
